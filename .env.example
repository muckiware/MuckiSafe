# MuckiSafe environment configuration
# Copy to .env and fill in real values:   cp .env.example .env

# --- Application -------------------------------------------------------------
# Public URL under which the admin UI is reachable (used for asset links etc.)
APP_URL=http://localhost:8080

# Port published on the Docker host for the admin UI
HTTP_PORT=8080

# --- SSH access (optional, public-key authentication only) --------------------
# SSH stays disabled while SSH_PUBLIC_KEYS is empty.
# Host port used by the optional docker-compose.ssh.yml override.
SSH_PORT=2222
# One key:
# SSH_PUBLIC_KEYS=ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... workstation
# Multiple keys: put a literal backslash-n between complete public-key lines.
# SSH_PUBLIC_KEYS="ssh-ed25519 AAAA... first\nssh-ed25519 AAAA... second"
SSH_PUBLIC_KEYS=

# Generate with:  openssl rand -hex 32
APP_SECRET=

# Random instance identifier. Generate with:  openssl rand -base64 24 | tr -d /+
INSTANCE_ID=

# --- First-boot admin account -------------------------------------------------
# Created automatically on first start (initial installation only).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# --- Database -----------------------------------------------------------------
DB_NAME=muckisafe
DB_USER=muckisafe
# Generate with:  openssl rand -hex 16
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- MuckiFacilityPlugin ------------------------------------------------------
# Encryption key for backup repository passwords.
# Generate with:  openssl rand -hex 32
# KEEP IT SAFE — without this value encrypted repository passwords cannot be
# read back, not even from a restored database!
MUWA_FACILITY_SECRET=

# --- Email (optional) ----------------------------------------------------------
# Needed if you want MuckiLogPlugin email notifications.
# Example SMTP:  smtp://user:pass@smtp.example.com:587
MAILER_DSN=null://null

# --- Project basics (initial installation) -----------------------------------------
PROJECT_NAME=MuckiSafe
PROJECT_EMAIL=admin@example.com
PROJECT_LOCALE=en-GB

# --- Scheduler ---------------------------------------------------------------
# Standard five-field cron expressions: minute hour day-of-month month weekday.
# Defaults run both Shopware commands every five minutes.
MESSENGER_CRON=*/5 * * * *
SCHEDULED_TASK_CRON=*/5 * * * *
SCHEDULER_TIMEZONE=Europe/Berlin