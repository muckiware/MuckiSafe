# MuckiSafe environment configuration
# Copy to .env and fill in real values:   cp .env.example .env

# --- Application -------------------------------------------------------------
# Public URL under which the admin UI is reachable (used for asset links etc.)
APP_URL=http://localhost:8080

# Port published on the Docker host for the admin UI
HTTP_PORT=8080

# Generate with:  openssl rand -hex 32
APP_SECRET=

# Random instance identifier. Generate with:  openssl rand -base64 24 | tr -d /+
INSTANCE_ID=

# --- First-boot admin account -------------------------------------------------
# Created automatically on first start (initial installation only).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@example.com

# --- Database -----------------------------------------------------------------
DB_NAME=muckisafe
DB_USER=muckisafe
# Generate with:  openssl rand -hex 16
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- MuckiFacilityPlugin ------------------------------------------------------
# Encryption key for backup repository passwords.
# Generate with:  openssl rand -hex 32
# KEEP IT SAFE — without this value encrypted repository passwords cannot be
# read back, not even from a restored database!
MUWA_FACILITY_SECRET=

# --- Email (optional) ----------------------------------------------------------
# Needed if you want MuckiLogPlugin email notifications.
# Example SMTP:  smtp://user:pass@smtp.example.com:587
MAILER_DSN=null://null

# --- Shop basics (initial installation) -----------------------------------------
SHOP_NAME=MuckiSafe
SHOP_EMAIL=admin@example.com
SHOP_LOCALE=en-GB
SHOP_CURRENCY=EUR