muckidrive/.env.*
muckidrive/parameters.txt
muckidrive/.uniqueid.txt
muckidrive/install.lock
muckidrive/custom/plugins/MuckiFacilityPlugin
muckidrive/custom/plugins/MuckiLogPlugin
