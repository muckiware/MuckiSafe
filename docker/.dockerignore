# Keep the docker build context clean — the CI clones muckidrive and builds
# from the repository root, this file controls what reaches the builder.

# VCS / IDE / local environment
.git
.gitignore
.github
.idea
.playwright-mcp
.claude
.DS_Store
**/.DS_Store
.ddev
.env
.env.*
!.env.example
parameters.txt
.uniqueid.txt
install.lock

# Build artifacts present in a dev checkout (regenerated inside the image)
vendor
**/node_modules
var/cache
var/log
public/bundles
public/asset-manifest.json
custom/muckiware/core.zip
custom/muckiware/master/Resources/public/assets
custom/muckiware/master/Resources/public/.vite
custom/muckiware/master/Resources/public/administration/.vite
custom/muckiware/master/Resources/public/administration/static/fixtures
custom/muckiware/master/Resources/app/administration/test/_mocks_

# Local test files
custom/plugins/MuckiLogPlugin/logfile.txt
**/.phpunit.result.cache